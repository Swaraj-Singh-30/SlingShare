---
import Layout from '../layouts/Layout.astro';
import { getArticleSchema, getBreadcrumbSchema } from '../config/site';

const title = "SlingShare — A Cross-Platform AirDrop Alternative for Windows & Android";
const description = "Looking for an AirDrop alternative that works across Windows, Android, Mac, Linux, and iOS? SlingShare delivers instant, cable-free sharing without Apple lock-in.";
const path = "/airdrop-alternative";

const structuredData = [
  getArticleSchema(title, description, path),
  getBreadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Alternatives", path: "/docs" },
    { name: "AirDrop Alternative", path: path },
  ]),
];
---

<Layout title={title} description={description} canonical={path} ogType="article" structuredData={structuredData}>
  <div class="article-page">
    <div class="container article-container">
      <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
        <a href="/">Home</a> / <a href="/docs">Alternatives</a> / <span>AirDrop Alternative</span>
      </nav>

      <header class="article-header">
        <div class="badge badge-coral">Cross-Platform Alternative</div>
        <h1>A Universal AirDrop Alternative That Works on Every Device</h1>
        <p class="lead">
          AirDrop is brilliant — until you need to share a file with someone on Windows, Android, or Linux. SlingShare brings that same zero-configuration sharing experience to any device with a web browser.
        </p>
      </header>

      <div class="article-body">
        <h2>Why AirDrop Leaves Non-Apple Users Behind</h2>
        <p>
          Apple's AirDrop relies on proprietary Bluetooth Low Energy (BLE) advertisements and an ad-hoc Wi-Fi network protocol (AWDL - Apple Wireless Direct Link). Because AWDL is closed-source and hardware-tied, AirDrop cannot operate on Windows, Android, or Linux machines.
        </p>
        <p>
          Google's Quick Share (formerly Nearby Share) has similar limitations, requiring specific Windows background services and Google Play Services on Android.
        </p>

        <h2>Feature Comparison</h2>
        <div class="table-container card">
          <table class="comparison-table">
            <thead>
              <tr>
                <th>Feature</th>
                <th>Apple AirDrop</th>
                <th>Google Quick Share</th>
                <th>SlingShare</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Supported Platforms</strong></td>
                <td>iOS, iPadOS, macOS only</td>
                <td>Android, Windows only</td>
                <td><span class="highlight-text">Any OS with a browser</span></td>
              </tr>
              <tr>
                <td><strong>Install Required</strong></td>
                <td>Built-in (Apple only)</td>
                <td>App install on PC</td>
                <td><span class="highlight-text">Zero install (Web app)</span></td>
              </tr>
              <tr>
                <td><strong>Account Needed</strong></td>
                <td>Apple ID (Contacts mode)</td>
                <td>Google Account</td>
                <td><span class="highlight-text">No account ever</span></td>
              </tr>
              <tr>
                <td><strong>Pairing Method</strong></td>
                <td>BLE advertisement</td>
                <td>BLE / Google Services</td>
                <td><span class="highlight-text">QR code or 6-char code</span></td>
              </tr>
              <tr>
                <td><strong>Encryption</strong></td>
                <td>TLS over AWDL</td>
                <td>TLS over Wi-Fi Direct</td>
                <td><span class="highlight-text">DTLS over WebRTC</span></td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2>How SlingShare Solves Cross-Platform Pairing</h2>
        <p>
          Instead of relying on hardware-level Bluetooth broadcasting which web browsers cannot arbitrarily invoke for security reasons, SlingShare uses temporary 6-character room codes and QR codes.
        </p>
        <p>
          You simply point your phone's camera at your computer screen (or share a 6-letter room code), and the devices instantly establish a direct WebRTC connection.
        </p>

        <div class="article-cta card-dark">
          <h3>Try the universal sharing experience</h3>
          <p style="color: var(--color-on-dark-soft); margin: 8px 0 20px;">Share files and text between any mix of Apple, Windows, and Android hardware.</p>
          <a href="/app" class="btn btn-primary">Launch SlingShare</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .article-page { padding: var(--spacing-xxl) 0; }
  .article-container { max-width: 820px; }
  .breadcrumb-nav { font-size: 0.85rem; color: var(--color-muted); margin-bottom: var(--spacing-lg); }
  .article-header { margin-bottom: var(--spacing-xl); }
  .article-header h1 { margin: var(--spacing-sm) 0 var(--spacing-md); }
  .article-body h2 { margin: var(--spacing-xl) 0 var(--spacing-sm); }
  .article-body p { margin-bottom: var(--spacing-md); line-height: 1.65; }
  .table-container { overflow-x: auto; margin: var(--spacing-lg) 0; padding: var(--spacing-md); }
  .comparison-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.9rem; }
  .comparison-table th, .comparison-table td { padding: 12px 14px; border-bottom: 1px solid var(--color-hairline); }
  .comparison-table th { font-family: var(--font-sans); font-weight: 600; color: var(--color-ink); }
  .highlight-text { color: var(--color-primary); font-weight: 600; }
  .article-cta { margin-top: var(--spacing-xxl); padding: var(--spacing-xl); text-align: center; }
</style>
