    // ==========================================================
    // RADAR INTERACTION FLOW: DISCOVER -> SELECT DEVICE -> SHARE
    // ==========================================================

    function selectDevice(dev: DiscoveredDevice) {
      selectedDevice = dev;
      trackEvent('device_selected', { device_type: dev.deviceType });

      // 1. Visually highlight on the Radar
      document.querySelectorAll('.radar-device-node').forEach((el) => {
        el.classList.remove('selected');
      });
      const matchNode = Array.from(radarNodesLayer.querySelectorAll('.radar-device-node')).find((el) =>
        el.getAttribute('aria-label')?.includes(dev.deviceName)
      );
      if (matchNode) matchNode.classList.add('selected');

      // 2. Populate Target Device Banner
      remotePeerNameEl.textContent = dev.deviceName;
      selectedTargetIconEl.innerHTML = getDeviceIconSvg(dev.deviceType);

      // 3. Reveal the Sharing Controls Overlay
      selectedSharingOverlay.style.display = 'flex';

      // 4. Check WebRTC connection state with this target
      if (webrtc && webrtc.isConnected() && connectedPeer && (connectedPeer.deviceName === dev.deviceName || connectedPeer.id === dev.deviceId)) {
        updateConnectionStateUI('connected', 'direct');
      } else {
        updateConnectionStateUI('connecting', 'unknown');

        // Cleanly reset any old connection if we were in a session with another peer
        if (currentSessionId && (!connectedPeer || connectedPeer.deviceName !== dev.deviceName)) {
          signaling.leaveSession(currentSessionId);
          currentSessionId = '';
          connectedPeer = null;
          webrtc.close();
        }

        // Initiate WebRTC pairing via signaling
        signaling.requestPairing(dev.deviceId, localDevice.deviceName, localDevice.deviceType);
      }
    }

    // "← Choose another device" handler: returns cleanly to Radar
    backToRadarBtn.addEventListener('click', () => {
      selectedDevice = null;
      document.querySelectorAll('.radar-device-node').forEach((el) => {
        el.classList.remove('selected');
      });
      selectedSharingOverlay.style.display = 'none';
    });

    // "Retry connection" handler: re-attempts pairing with selected device
    retryConnectionBtn?.addEventListener('click', () => {
      if (selectedDevice) {
        selectDevice(selectedDevice);
      }
    });

    // Close overlay on backdrop click outside the card
    selectedSharingOverlay.addEventListener('click', (e) => {
      if (e.target === selectedSharingOverlay) {
        selectedDevice = null;
        document.querySelectorAll('.radar-device-node').forEach((el) => {
          el.classList.remove('selected');
        });
        selectedSharingOverlay.style.display = 'none';
      }
    });

    // Render Discovered Devices in the Vast Radar Expanse (Matching Picture 1)
    function renderDiscoveredDevices() {
      const list = Array.from(discoveredDevices.values()).filter((d) => d.deviceId !== localDevice.deviceId);
      const count = list.length;

      if (count === 0) {
        discoveryStatusText.textContent = 'Looking for nearby SlingShare devices...';
        radarNodesLayer.innerHTML = '';
        discoveredItemsList.innerHTML = '<div class="empty-list-state">No other SlingShare devices found right now.</div>';
        return;
      }

      // Calm sky prompt matching reference image Picture 1
      discoveryStatusText.textContent = 'Click to send files or right click to send a message and paste an image';

      // 1. Render Radar Nodes (Plotting in upper semi-circle sector above bottom center)
      radarNodesLayer.innerHTML = '';
      
      list.forEach((dev, index) => {
        let angleDeg = -90;
        let radiusPct = 52;

        if (count === 1) {
          angleDeg = -90;
          radiusPct = 52;
        } else if (count === 2) {
          angleDeg = index === 0 ? -120 : -60;
          radiusPct = 52;
        } else if (count === 3) {
          angleDeg = index === 0 ? -135 : index === 1 ? -90 : -45;
          radiusPct = 52;
        } else {
          const minAngle = -140;
          const maxAngle = -40;
          const step = (maxAngle - minAngle) / (count - 1);
          angleDeg = minAngle + index * step;
          radiusPct = index % 2 === 0 ? 54 : 46;
        }

        const angleRad = (angleDeg * Math.PI) / 180;
        // Origin is bottom center: (50%, 96%)
        const x = 50 + (radiusPct * 0.78) * Math.cos(angleRad);
        const y = 96 + (radiusPct * 0.92) * Math.sin(angleRad);

        const node = document.createElement('button');
        node.className = 'radar-device-node';
        node.type = 'button';
        node.style.left = `${x.toFixed(2)}%`;
        node.style.top = `${y.toFixed(2)}%`;
        node.setAttribute('aria-label', `Connect to ${dev.deviceName}`);
        node.title = `${dev.deviceName} (${dev.deviceType}) — Click to pair`;

        if (selectedDevice && selectedDevice.deviceId === dev.deviceId) {
          node.classList.add('selected');
        }

        // Circular electric blue bubble
        const bubble = document.createElement('div');
        bubble.className = 'radar-node-bubble';

        const iconEl = document.createElement('span');
        iconEl.className = 'radar-node-icon';
        iconEl.innerHTML = getDeviceIconSvg(dev.deviceType);
        bubble.appendChild(iconEl);

        // Text group directly under bubble (Clean, centered text without white box)
        const textGroup = document.createElement('div');
        textGroup.className = 'radar-node-text-group';

        const labelEl = document.createElement('span');
        labelEl.className = 'radar-node-label';
        labelEl.textContent = dev.deviceName;

        const typeEl = document.createElement('span');
        typeEl.className = 'radar-node-type';
        typeEl.textContent = formatDeviceTypeLabel(dev.deviceType);

        textGroup.appendChild(labelEl);
        textGroup.appendChild(typeEl);

        node.appendChild(bubble);
        node.appendChild(textGroup);

        // Click handler: initiates pairing & reveals sharing card
        node.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          selectDevice(dev);
        });

        radarNodesLayer.appendChild(node);
      });

      // 2. Render List View Fallback
      discoveredItemsList.innerHTML = '';
      list.forEach((dev) => {
        const item = document.createElement('div');
        item.className = 'discovered-list-item card';

        const info = document.createElement('div');
        info.className = 'discovered-item-info';

        const icon = document.createElement('span');
        icon.className = 'discovered-item-icon';
        icon.innerHTML = getDeviceIconSvg(dev.deviceType);

        const textGroup = document.createElement('div');
        const name = document.createElement('strong');
        name.textContent = dev.deviceName;
        const sub = document.createElement('span');
        sub.className = 'discovered-item-sub';
        sub.textContent = `${formatDeviceTypeLabel(dev.deviceType)} • Available`;

        textGroup.appendChild(name);
        textGroup.appendChild(sub);
        info.appendChild(icon);
        info.appendChild(textGroup);

        const btn = document.createElement('button');
        btn.className = 'btn btn-primary btn-sm';
        btn.textContent = 'Connect';
        btn.addEventListener('click', () => {
          selectDevice(dev);
        });

        item.appendChild(info);
        item.appendChild(btn);
        discoveredItemsList.appendChild(item);
      });
    }

    // Centralized View Mode Switcher (Radar <-> List) via Header Controls
    function switchView(mode: 'radar' | 'list') {
      currentViewMode = mode;
      const isRadar = mode === 'radar';

      radarViewport.style.display = isRadar ? 'flex' : 'none';
      discoveryListContainer.style.display = isRadar ? 'none' : 'block';

      if (headerViewRadarBtn) headerViewRadarBtn.classList.toggle('active', isRadar);
      if (headerViewListBtn) headerViewListBtn.classList.toggle('active', !isRadar);

      if (isRadar) {
        renderRadarNodes();
      } else {
        renderDiscoveryList();
      }
    }

    headerViewRadarBtn?.addEventListener('click', () => switchView('radar'));
    headerViewListBtn?.addEventListener('click', () => switchView('list'));

    function updateConnectionStateUI(state: 'connected' | 'connecting' | 'disconnected', type: string = 'direct') {
      const isConn = state === 'connected';
      const targetName = selectedDevice ? selectedDevice.deviceName : 'device';

      if (isConn) {
        statusDotEl.className = 'status-indicator connected';
        connectionStatusTextEl.textContent = 'Connected';
        connectionTypeBadgeEl.style.display = 'inline-flex';
        connectionTypeBadgeEl.textContent = type === 'relayed' ? 'Relayed (TURN)' : 'Direct P2P';
        remotePeerSubtitleEl.textContent = `${type === 'relayed' ? 'Relayed (TURN)' : 'Direct WebRTC'} • Encrypted`;
        sendTextBtn.disabled = textShareInput.value.trim().length === 0;
        waitingPrompt.style.display = 'none';
        dropZone.classList.remove('disabled');

        if (dropZoneTitleEl) dropZoneTitleEl.textContent = 'Send file';
        if (dropZoneSubtitleEl) dropZoneSubtitleEl.textContent = 'Drag & drop or click to choose file';
        if (dropZoneHintEl) dropZoneHintEl.textContent = 'Direct WebRTC DataChannel streaming';
        if (dropZoneIconEl) {
          dropZoneIconEl.innerHTML = `<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>`;
        }
        if (retryConnectionBtn) retryConnectionBtn.style.display = 'none';
      } else if (state === 'connecting') {
        statusDotEl.className = 'status-indicator connecting';
        connectionStatusTextEl.textContent = 'Connecting...';
        connectionTypeBadgeEl.style.display = 'none';
        remotePeerSubtitleEl.textContent = `Connecting to ${targetName}...`;
        sendTextBtn.disabled = true;
        dropZone.classList.add('disabled');

        if (dropZoneTitleEl) dropZoneTitleEl.textContent = `Connecting to ${targetName}...`;
        if (dropZoneSubtitleEl) dropZoneSubtitleEl.textContent = 'File transfer will enable automatically once connected';
        if (dropZoneHintEl) dropZoneHintEl.textContent = 'Negotiating WebRTC peer connection...';
        if (dropZoneIconEl) {
          dropZoneIconEl.innerHTML = `<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`;
        }
        if (retryConnectionBtn) retryConnectionBtn.style.display = 'none';
      } else {
        statusDotEl.className = 'status-indicator disconnected';
        connectionStatusTextEl.textContent = currentSessionId ? 'Waiting for peer' : 'Ready';
        connectionTypeBadgeEl.style.display = 'none';
        remotePeerSubtitleEl.textContent = selectedDevice ? `Couldn't connect to ${targetName}` : 'Device disconnected';
        sendTextBtn.disabled = true;
        dropZone.classList.add('disabled');

        if (dropZoneTitleEl) dropZoneTitleEl.textContent = selectedDevice ? `Couldn't connect to ${targetName}` : 'Device disconnected';
        if (dropZoneSubtitleEl) dropZoneSubtitleEl.textContent = 'Click "Retry" or choose another device';
        if (dropZoneHintEl) dropZoneHintEl.textContent = 'WebRTC DataChannel closed';
        if (dropZoneIconEl) {
          dropZoneIconEl.innerHTML = `<svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;
        }
        if (retryConnectionBtn && selectedDevice) retryConnectionBtn.style.display = 'inline-flex';
      }
    }

    // Initialize WebRTC & Transfer Managers
    function initNetworking() {
      webrtc = new WebRTCManager([], {
        onConnectionStateChange: (state, type) => {
          if (state === 'connected') {
            updateConnectionStateUI('connected', type);
          } else if (state === 'connecting' || state === 'reconnecting') {
            updateConnectionStateUI('connecting', type);
          } else {
            updateConnectionStateUI('disconnected', type);
          }
        },

        onDataChannelStateChange: (isOpen) => {
          if (isOpen) {
            console.log('[app] Direct WebRTC data channel opened');
            showToast('Direct WebRTC connection established');
            updateConnectionStateUI('connected', 'direct');
            selectedSharingOverlay.style.display = 'flex';
            if (connectedPeer) {
              remotePeerNameEl.textContent = connectedPeer.deviceName;
              selectedTargetIconEl.innerHTML = getDeviceIconSvg(connectedPeer.deviceType);
            }
            transferMgr.resumeInterruptedReceives();

            // Auto-send any pending files if the user queued them while connecting!
            if (pendingFilesToSend.length > 0) {
              const toSend = [...pendingFilesToSend];
              pendingFilesToSend = [];
              handleFilesSelected(toSend);
            }
          } else {
            updateConnectionStateUI('disconnected');
          }
        },

        onMessageReceived: (msg: DataChannelMessage) => {
          if (msg.type === 'text') {
            handleReceivedText(msg);
          } else {
            transferMgr.handleIncomingMessage(msg);
          }
        },

        onBinaryChunkReceived: (data: ArrayBuffer) => {
          transferMgr.handleBinaryChunk(data);
        },

        onSendOffer: (targetId, sdp) => {
          signaling.sendOffer(targetId, sdp);
        },

        onSendAnswer: (targetId, sdp) => {
          signaling.sendAnswer(targetId, sdp);
        },

        onSendIceCandidate: (targetId, candidate) => {
          signaling.sendIceCandidate(targetId, candidate);
        },
      });

      transferMgr = new TransferManager(webrtc, {
        onTransferProgress: (state) => {
          renderTransferItem(state);
          selectedSharingOverlay.style.display = 'flex';
          tabFilesBtn.click();
        },
        onTransferComplete: (state) => {
          renderTransferItem(state);
          showToast(`Completed: ${state.fileName}`);
          if (state.direction === 'sending') {
            trackEvent('file_sent', { file_size: state.fileSize, mime_type: state.mimeType });
          } else {
            trackEvent('file_received', { file_size: state.fileSize, mime_type: state.mimeType });
          }
        },
        onTransferFailed: (state, err) => {
          renderTransferItem(state);
          showToast(`Transfer failed: ${err}`);
        },
        onTransferCancelled: (state) => {
          renderTransferItem(state);
          showToast('Transfer cancelled');
        },
      });

      signaling = new SignalingClient({
        onStateChange: (connected) => {
          if (!connected && currentSessionId) {
            connectionStatusTextEl.textContent = 'Signaling offline';
          }
          if (connected) {
            // Register presence for Radar discovery
            signaling.registerPresence(localDevice.deviceId, localDevice.deviceName, localDevice.deviceType);
          }
        },

        // Discovery Callbacks
        onPresenceList: (devices) => {
          discoveredDevices.clear();
          devices.forEach((d) => discoveredDevices.set(d.deviceId, d));
          renderDiscoveredDevices();
        },

        onDeviceJoined: (device) => {
          discoveredDevices.set(device.deviceId, device);
          renderDiscoveredDevices();
          trackEvent('device_discovered', { device_type: device.deviceType });
        },

        onDeviceLeft: (deviceId) => {
          discoveredDevices.delete(deviceId);
          renderDiscoveredDevices();
          if (selectedDevice && selectedDevice.deviceId === deviceId) {
            showToast(`${selectedDevice.deviceName} went offline`);
            updateConnectionStateUI('disconnected');
          }
        },

        onDeviceUpdated: (device) => {
          discoveredDevices.set(device.deviceId, device);
          renderDiscoveredDevices();
          if (selectedDevice && selectedDevice.deviceId === device.deviceId) {
            selectedDevice = device;
            remotePeerNameEl.textContent = device.deviceName;
          }
        },

        onPairingInitiated: (sessionId, targetDeviceId) => {
          isInitiator = true;
          currentSessionId = sessionId;
          onJoinedSessionUI(sessionId);
          signaling.joinSession(sessionId, localDevice.deviceName, localDevice.deviceType);
        },

        onPairingInvitation: (sessionId, fromDevice) => {
          if (currentSessionId && currentSessionId !== sessionId) {
            webrtc.close();
          }
          isInitiator = false;
          currentSessionId = sessionId;
          showToast(`Connecting with ${fromDevice.deviceName}...`);
          onJoinedSessionUI(sessionId);
          
          // Open selected sharing card for the receiver
          selectedDevice = fromDevice;
          remotePeerNameEl.textContent = fromDevice.deviceName;
          selectedTargetIconEl.innerHTML = getDeviceIconSvg(fromDevice.deviceType);
          selectedSharingOverlay.style.display = 'flex';

          signaling.joinSession(sessionId, localDevice.deviceName, localDevice.deviceType);
        },

        // Session Callbacks
        onSessionCreated: (sessionId, peerId, iceServers) => {
          currentSessionId = sessionId;
          myPeerId = peerId;
          isInitiator = true;
          webrtc.setIceServers(iceServers);
          onJoinedSessionUI(sessionId);
          showToast(`Session ${sessionId} created`);
          trackEvent('room_created');
        },

        onSessionJoined: (sessionId, peerId, peers, iceServers) => {
          currentSessionId = sessionId;
          myPeerId = peerId;
          webrtc.setIceServers(iceServers);
          onJoinedSessionUI(sessionId);

          if (peers.length > 0) {
            const peer = peers[0];
            setConnectedPeer(peer);
            // If we are initiator and the peer is already in the room, start connection!
            if (isInitiator) {
              console.log('[signaling] Initiator joined session with existing peer, initiating WebRTC connection to', peer.id);
              webrtc.initiateConnection(peer.id);
            }
          }
        },

        onPeerJoined: (peerId, deviceName, deviceType) => {
          const peer = { id: peerId, deviceName, deviceType };
          setConnectedPeer(peer);
          showToast(`${deviceName} connected`);

          if (isInitiator) {
            console.log('[signaling] Peer joined session, initiating WebRTC connection to', peerId);
            webrtc.initiateConnection(peerId);
          }
        },

        onPeerLeft: (peerId) => {
          if (connectedPeer && connectedPeer.id === peerId) {
            showToast(`${connectedPeer.deviceName} disconnected`);
            setConnectedPeer(null);
            webrtc.close();
            updateConnectionStateUI('disconnected');
            if (currentSessionId) {
              waitingPrompt.style.display = 'block';
            }
          }
        },

        onOffer: (senderId, sdp) => {
          webrtc.handleOffer(senderId, sdp);
        },

        onAnswer: (senderId, sdp) => {
          webrtc.handleAnswer(sdp);
        },

        onIceCandidate: (senderId, candidate) => {
          webrtc.handleIceCandidate(candidate);
        },

        onError: (err) => {
          showToast(err);
        },
      });

      signaling.connect().catch((err) => {
        console.warn('Initial signaling connection deferred:', err);
      });
    }

    function setConnectedPeer(peer: { id: string; deviceName: string; deviceType: string } | null) {
      connectedPeer = peer;
      if (peer) {
        remotePeerNameEl.textContent = peer.deviceName;
        if (bannerRemotePeerName) bannerRemotePeerName.textContent = peer.deviceName;
        remotePeerIconEl.innerHTML = getDeviceIconSvg(peer.deviceType);
        selectedTargetIconEl.innerHTML = getDeviceIconSvg(peer.deviceType);
        waitingPrompt.style.display = 'none';
        updateConnectionStateUI('connecting', 'direct');
      } else {
        updateConnectionStateUI('disconnected');
      }
    }

    function onJoinedSessionUI(code: string) {
      sessionEntryGroup.style.display = 'none';
      sessionActiveGroup.style.display = 'flex';
      activeSessionCodeEl.textContent = code;
      waitingPromptCodeEl.textContent = code;

      if (!connectedPeer) {
        waitingPrompt.style.display = 'block';
      }
    }

    function onLeftSessionUI() {
      sessionEntryGroup.style.display = 'flex';
      sessionActiveGroup.style.display = 'none';
      peerBanner.style.display = 'none';
      waitingPrompt.style.display = 'none';
      activeSessionCodeEl.textContent = '------';
      connectedPeer = null;
      selectedDevice = null;
      currentSessionId = '';
      webrtc.close();
      transferMgr.cleanup();
      selectedSharingOverlay.style.display = 'none';
      updateConnectionStateUI('disconnected');
    }

    // Transfers UI Rendering
    function updateTransfersCount() {
      const count = transfersList.querySelectorAll('.transfer-item').length;
      transfersCountEl.textContent = `${count} active`;
      if (headerTransfersBadge) {
        headerTransfersBadge.textContent = `${count}`;
        headerTransfersBadge.style.display = count > 0 ? 'inline-flex' : 'none';
      }
      emptyTransfersState.style.display = count === 0 ? 'block' : 'none';
    }

    function renderTransferItem(state: FileTransferState) {
      emptyTransfersState.style.display = 'none';
      let item = document.getElementById(`transfer-${state.id}`);

      const isCompleted = state.status === 'completed';
      const isFailed = state.status === 'failed' || state.status === 'cancelled';
      const isReceiving = state.direction === 'receiving';
      const isSending = state.direction === 'sending';

      if (!item) {
        item = document.createElement('div');
        item.id = `transfer-${state.id}`;
        transfersList.prepend(item);
      }

      if (isCompleted && isReceiving) {
        item.className = 'transfer-item transfer-received-completed card';
        item.innerHTML = '';

        const main = document.createElement('div');
        main.className = 'received-card-main';

        const iconWrap = document.createElement('div');
        iconWrap.className = 'received-icon-wrapper';
        iconWrap.setAttribute('aria-hidden', 'true');
        iconWrap.innerHTML = getFileCategoryIconSvg(state.fileName, state.mimeType);

        const details = document.createElement('div');
        details.className = 'received-details';

        const nameEl = document.createElement('span');
        nameEl.className = 'received-file-name';
        nameEl.textContent = state.fileName;
        nameEl.title = state.fileName;

        const subEl = document.createElement('span');
        subEl.className = 'received-file-sub';
        subEl.textContent = `${formatBytes(state.fileSize)} · ${getFileExtension(state.fileName)}`;

        details.appendChild(nameEl);
        details.appendChild(subEl);
        main.appendChild(iconWrap);
        main.appendChild(details);

        const actions = document.createElement('div');
        actions.className = 'received-actions';

        const badge = document.createElement('span');
        badge.className = 'badge badge-success';
        badge.textContent = 'Complete & Verified';
        actions.appendChild(badge);

        const dlLink = document.createElement('a');
        dlLink.className = 'btn-download';
        dlLink.setAttribute('role', 'button');
        dlLink.setAttribute('aria-label', `Download ${state.fileName}`);
        dlLink.title = `Download ${state.fileName}`;

        // Ensure object URL exists
        let dlUrl = state.downloadUrl;
        if (!dlUrl && state.blob) {
          dlUrl = URL.createObjectURL(state.blob);
          state.downloadUrl = dlUrl;
        }
        if (dlUrl) {
          dlLink.href = dlUrl;
          dlLink.download = state.fileName;
        }

        dlLink.innerHTML = `
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
            <polyline points="7 10 12 15 17 10"/>
            <line x1="12" y1="15" x2="12" y2="3"/>
          </svg>
          <span>Download</span>
        `;

        // Direct click fallback to ensure browser download always triggers reliably
        dlLink.addEventListener('click', (e) => {
          trackEvent('file_downloaded', { file_size: state.fileSize, mime_type: state.mimeType });
          if (!dlLink.getAttribute('href') || dlLink.getAttribute('href') === '#') {
            e.preventDefault();
            if (state.blob) {
              const u = URL.createObjectURL(state.blob);
              state.downloadUrl = u;
              dlLink.href = u;
              const a = document.createElement('a');
              a.href = u;
              a.download = state.fileName;
              document.body.appendChild(a);
              a.click();
              document.body.removeChild(a);
            }
          }
          showToast(`Downloading ${state.fileName}...`);
        });

        actions.appendChild(dlLink);
        item.appendChild(main);
        item.appendChild(actions);

      } else if (isCompleted && isSending) {
        item.className = 'transfer-item transfer-sent-completed card';
        item.innerHTML = '';

        const main = document.createElement('div');
        main.className = 'received-card-main';

        const iconWrap = document.createElement('div');
        iconWrap.className = 'received-icon-wrapper';
        iconWrap.setAttribute('aria-hidden', 'true');
        iconWrap.innerHTML = getFileCategoryIconSvg(state.fileName, state.mimeType);

        const details = document.createElement('div');
        details.className = 'received-details';

        const nameEl = document.createElement('span');
        nameEl.className = 'received-file-name';
        nameEl.textContent = state.fileName;
        nameEl.title = state.fileName;

        const subEl = document.createElement('span');
        subEl.className = 'received-file-sub';
        subEl.textContent = `${formatBytes(state.fileSize)} · ${getFileExtension(state.fileName)}`;

        details.appendChild(nameEl);
        details.appendChild(subEl);
        main.appendChild(iconWrap);
        main.appendChild(details);

        const actions = document.createElement('div');
        actions.className = 'received-actions';

        const badge = document.createElement('span');
        badge.className = 'badge badge-success';
        badge.textContent = 'Complete & Verified';
        actions.appendChild(badge);

        item.appendChild(main);
        item.appendChild(actions);

      } else if (isFailed) {
        item.className = 'transfer-item transfer-failed card';
        item.innerHTML = '';

        const main = document.createElement('div');
        main.className = 'received-card-main';

        const iconWrap = document.createElement('div');
        iconWrap.className = 'received-icon-wrapper error';
        iconWrap.setAttribute('aria-hidden', 'true');
        iconWrap.innerHTML = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>`;

        const details = document.createElement('div');
        details.className = 'received-details';

        const nameEl = document.createElement('span');
        nameEl.className = 'received-file-name';
        nameEl.textContent = state.fileName;
        nameEl.title = state.fileName;

        const subEl = document.createElement('span');
        subEl.className = 'received-file-sub text-error';
        const isIntegrity = state.error?.includes('Integrity') || (state.status === 'failed' && state.sha256Expected && state.sha256Actual && state.sha256Expected !== state.sha256Actual);
        subEl.textContent = isIntegrity ? "Couldn't verify file" : (state.error || 'Transfer failed');

        details.appendChild(nameEl);
        details.appendChild(subEl);
        main.appendChild(iconWrap);
        main.appendChild(details);

        const actions = document.createElement('div');
        actions.className = 'received-actions';

        const badge = document.createElement('span');
        badge.className = 'badge badge-error';
        badge.textContent = isIntegrity ? 'Verification Failed' : (state.status === 'cancelled' ? 'Cancelled' : 'Failed');
        actions.appendChild(badge);

        item.appendChild(main);
        item.appendChild(actions);

      } else {
        // In-progress transfer (sending, receiving, or verifying)
        item.className = 'transfer-item transfer-in-progress card';

        const pct = Math.max(0, Math.min(100, state.progressPercent || 0));
        const statusLabel = state.status === 'verifying'
          ? 'Verifying integrity (SHA-256)...'
          : `${isSending ? 'Sending' : 'Receiving'}... ${formatBytes(state.transferredBytes || 0)} of ${formatBytes(state.fileSize || 0)} (${pct}%)`;

        item.innerHTML = `
          <div class="transfer-card-header">
            <div class="received-icon-wrapper" aria-hidden="true">
              ${getFileCategoryIconSvg(state.fileName, state.mimeType)}
            </div>
            <div class="transfer-details">
              <span class="transfer-file-name" title="${escapeHtml(state.fileName)}">${escapeHtml(state.fileName)}</span>
              <span class="transfer-status-text">${statusLabel}</span>
            </div>
            <button class="btn-cancel-transfer" data-id="${state.id}" aria-label="Cancel transfer" title="Cancel">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
              </svg>
            </button>
          </div>
          <div class="progress-bar" role="progressbar" aria-valuenow="${pct}" aria-valuemin="0" aria-valuemax="100">
            <div class="progress-fill" style="width: ${pct}%"></div>
          </div>
        `;

        item.querySelector('.btn-cancel-transfer')?.addEventListener('click', () => {
          transferMgr.cancelTransfer(state.id);
        });
      }

      updateTransfersCount();
    }

    // ==========================================================
    // FILE TRANSFER IMPLEMENTATION
    // ==========================================================

    dropZone.addEventListener('click', () => {
      if (dropZone.classList.contains('disabled') || !webrtc.isConnected()) {
        const targetName = selectedDevice ? selectedDevice.deviceName : 'device';
        showToast(`Connecting to ${targetName}... File upload will be available once connected.`);
        return;
      }
      fileInput.click();
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFilesSelected(Array.from(fileInput.files));
        fileInput.value = '';
      }
    });

    // Window-wide drag & drop into radar or drop zone
    ['dragenter', 'dragover'].forEach((eventName) => {
      window.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.add('drag-active');
      });
    });

    ['dragleave', 'drop'].forEach((eventName) => {
      window.addEventListener(eventName, (e) => {
        e.preventDefault();
        dropZone.classList.remove('drag-active');
      });
    });

    window.addEventListener('drop', (e) => {
      e.preventDefault();
      if (e.dataTransfer && e.dataTransfer.files.length > 0) {
        handleFilesSelected(Array.from(e.dataTransfer.files));
        selectedSharingOverlay.style.display = 'flex';
        tabFilesBtn.click();
      }
    });

    function handleFilesSelected(files: File[]) {
      if (!files || files.length === 0) return;

      if (!webrtc.isConnected()) {
        pendingFilesToSend = files;
        const targetName = selectedDevice ? selectedDevice.deviceName : 'device';
        showToast(`Connecting to ${targetName}... File will send automatically once connected.`);
        return;
      }

      for (const file of files) {
        transferMgr.sendFile(file).then((transferId) => {
          showToast(`Sending ${file.name}...`);
        }).catch((err) => {
          showToast(`Transfer error: ${err.message}`);
        });
      }
    }

    // ==========================================================
    // TEXT & CLIPBOARD SHARING IMPLEMENTATION
    // ==========================================================

    textShareInput.addEventListener('input', () => {
      const len = textShareInput.value.length;
      textCharCountEl.textContent = `${len} character${len === 1 ? '' : 's'}`;
      sendTextBtn.disabled = textShareInput.value.trim().length === 0 || !webrtc.isConnected();
    });

    function doSendText() {
      const text = textShareInput.value;
      if (!text || text.trim().length === 0) return;

      if (!webrtc.isConnected()) {
        showToast('Connecting with device... please wait.');
        return;
      }

      const sent = webrtc.sendTextMessage(text, localDevice.deviceName);
      if (sent) {
        appendMessage(text, 'sent', localDevice.deviceName);
        textShareInput.value = '';
        textCharCountEl.textContent = '0 characters';
        sendTextBtn.disabled = true;
        trackEvent('text_sent', { char_count: text.length });
      } else {
        showToast('Could not send message. Please check connection.');
      }
    }

    sendTextBtn.addEventListener('click', doSendText);

    textShareInput.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'Enter') {
        e.preventDefault();
        doSendText();
      }
    });

    pasteClipboardBtn.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          textShareInput.value = text;
          textShareInput.dispatchEvent(new Event('input'));
          showToast('Pasted from clipboard');
        }
      } catch (err) {
        showToast('Could not access clipboard. Please paste manually.');
      }
    });

    function handleReceivedText(msg: any) {
      let text = '';
      if (typeof msg.text === 'string') {
        text = msg.text;
      } else if (msg.payload && typeof msg.payload.text === 'string') {
        text = msg.payload.text;
      } else if (typeof msg.payload === 'string') {
        text = msg.payload;
      }
      if (!text) return;

      const sender = msg.senderName || (connectedPeer ? connectedPeer.deviceName : 'Remote Peer');
      appendMessage(text, 'received', sender);
      showToast(`Text received from ${sender}`);
      trackEvent('text_received', { char_count: text.length });
      // Reveal text tab so receiver sees snippet immediately
      selectedSharingOverlay.style.display = 'flex';
      tabTextBtn.click();
    }

    function appendMessage(text: string, direction: 'sent' | 'received', senderName: string) {
      emptyMessagesState.style.display = 'none';
      messagesHeaderRow.style.display = 'flex';

      const item = document.createElement('div');
      item.className = `message-item message-${direction} card`;

      const header = document.createElement('div');
      header.className = 'message-header';
      const sender = document.createElement('strong');
      sender.textContent = direction === 'sent' ? 'You' : senderName;
      const time = document.createElement('span');
      time.className = 'message-time';
      time.textContent = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

      header.appendChild(sender);
      header.appendChild(time);

      const body = document.createElement('div');
      body.className = 'message-body';
      body.textContent = text; // Safe text insertion, preserves emojis & newlines without HTML execution

      const actions = document.createElement('div');
      actions.className = 'message-actions';
      const copyBtn = document.createElement('button');
      copyBtn.className = 'btn-text-action';
      copyBtn.textContent = 'Copy';
      copyBtn.addEventListener('click', () => {
        navigator.clipboard.writeText(text).then(() => showToast('Copied to clipboard'));
      });
      actions.appendChild(copyBtn);

      item.appendChild(header);
      item.appendChild(body);
      item.appendChild(actions);

      messagesList.appendChild(item);
      messagesList.scrollTop = messagesList.scrollHeight;
    }

    clearMessagesBtn.addEventListener('click', () => {
      messagesList.innerHTML = '';
      emptyMessagesState.style.display = 'block';
      messagesHeaderRow.style.display = 'none';
    });

    // Session Management Actions
    createSessionBtn.addEventListener('click', () => {
      if (!signaling.isConnected()) {
        showToast('Connecting to signaling server...');
        return;
      }
      signaling.createSession(localDevice.deviceName, localDevice.deviceType);
    });

    joinSessionBtn.addEventListener('click', () => {
      const code = joinCodeInput.value.trim().toUpperCase();
      if (code.length < 4) {
        showToast('Please enter a valid room code');
        return;
      }
      if (!signaling.isConnected()) {
        showToast('Connecting to signaling server...');
        return;
      }
      isInitiator = false;
      signaling.joinSession(code, localDevice.deviceName, localDevice.deviceType);
    });

    copyCodeBtn.addEventListener('click', () => {
      if (currentSessionId) {
        navigator.clipboard.writeText(currentSessionId).then(() => {
          showToast(`Room code ${currentSessionId} copied`);
        });
      }
    });

    showQrBtn.addEventListener('click', () => {
      openQrModal();
    });

    waitingPromptQrBtn.addEventListener('click', () => {
      openQrModal();
    });

    leaveSessionBtn.addEventListener('click', () => {
      if (signaling && currentSessionId) {
        signaling.leaveSession(currentSessionId);
      }
      onLeftSessionUI();
      showToast('Left session');
    });

    modalLeaveSessionBtn?.addEventListener('click', () => {
      if (signaling && currentSessionId) {
        signaling.leaveSession(currentSessionId);
      }
      onLeftSessionUI();
      sessionModal?.close();
      showToast('Left session');
    });

    // QR Code Modal
    function openQrModal() {
      if (!currentSessionId) return;
      const shareUrl = `${window.location.origin}/app?join=${currentSessionId}`;
      shareUrlInput.value = shareUrl;

      QRCode.toCanvas(
        qrCanvas,
        shareUrl,
        {
          width: 220,
          margin: 2,
          color: {
            dark: '#141413',
            light: '#ffffff',
          },
        },
        (err) => {
          if (err) console.error('QR generation error:', err);
        }
      );

      qrModal.showModal();
    }

    closeQrModalBtn.addEventListener('click', () => {
      qrModal.close();
    });

    copyShareUrlBtn.addEventListener('click', () => {
      navigator.clipboard.writeText(shareUrlInput.value).then(() => {
        showToast('Pairing link copied to clipboard');
      });
    });

    // Mode Tabs Navigation: [ File ] vs [ Text ]
    tabFilesBtn.addEventListener('click', () => {
      tabFilesBtn.classList.add('active');
      tabTextBtn.classList.remove('active');
      tabFilesBtn.setAttribute('aria-selected', 'true');
      tabTextBtn.setAttribute('aria-selected', 'false');
      panelFiles.style.display = 'block';
      panelText.style.display = 'none';
    });

    tabTextBtn.addEventListener('click', () => {
      tabTextBtn.classList.add('active');
      tabFilesBtn.classList.remove('active');
      tabTextBtn.setAttribute('aria-selected', 'true');
      tabFilesBtn.setAttribute('aria-selected', 'false');
      panelText.style.display = 'block';
      panelFiles.style.display = 'none';
      textShareInput.focus();
    });

    headerWorkspaceToggleBtn?.addEventListener('click', () => {
      if (selectedDevice || connectedPeer) {
        const isShown = selectedSharingOverlay.style.display === 'flex';
        selectedSharingOverlay.style.display = isShown ? 'none' : 'flex';
      } else {
        showToast('Click a device on the Radar to start sharing.');
      }
    });

    // Check URL parameters for auto-joining (?join=ROOM)
    function checkUrlJoinParam() {
      const params = new URLSearchParams(window.location.search);
      const joinCode = params.get('join');
      if (joinCode) {
        const cleanCode = joinCode.trim().toUpperCase();
        window.history.replaceState({}, document.title, window.location.pathname);
        setTimeout(() => {
          if (signaling.isConnected()) {
            isInitiator = false;
            signaling.joinSession(cleanCode, localDevice.deviceName, localDevice.deviceType);
          }
        }, 600);
      }
    }

    // Startup Execution
    initDeviceIdentity();
    initNetworking();
    checkUrlJoinParam();
  </script>
</Layout>

<style is:global>
  /* =========================================================
     GLOBAL RADAR & APP STYLES (MATCHING VISUAL REFERENCE PICTURE 1)
     ========================================================= */

  .app-viewport {
    width: 100%;
    min-height: calc(100vh - 60px);
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: var(--color-canvas);
    overflow: hidden;
  }

  /* ---------------------------------------------------------
     Dominant Radar Surface
     --------------------------------------------------------- */
  .radar-surface {
    flex: 1;
    width: 100%;
    min-height: calc(100vh - 60px);
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
  }

  .radar-canvas {
    width: 100%;
    height: calc(100vh - 60px);
    min-height: 520px;
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    overflow: hidden;
    background: radial-gradient(circle at 50% 100%, rgba(37, 99, 235, 0.04) 0%, transparent 65%);
  }

  /* ---------------------------------------------------------
     Concentric Radar Arcs anchored at bottom center (50%, 100%)
     --------------------------------------------------------- */
  .radar-arcs-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 1;
  }

  .radar-arc {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translate(-50%, 50%);
    border-radius: 50%;
    border: 1px solid var(--radar-arc-color);
    pointer-events: none;
  }

  .radar-arc-1 { width: 320px; height: 320px; }
  .radar-arc-2 { width: 620px; height: 620px; }
  .radar-arc-3 { width: 960px; height: 960px; }
  .radar-arc-4 { width: 1340px; height: 1340px; }
  .radar-arc-5 { width: 1760px; height: 1760px; }
  .radar-arc-6 { width: 2220px; height: 2220px; }
  .radar-arc-7 { width: 2720px; height: 2720px; }
  .radar-arc-8 { width: 3260px; height: 3260px; }

  /* Very subtle ambient sweep - no harsh spotlight lines */
  .radar-scan-sweep {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 2800px;
    height: 2800px;
    transform: translate(-50%, 50%);
    border-radius: 50%;
    pointer-events: none;
    background: conic-gradient(
      from 180deg at 50% 50%,
      transparent 0deg,
      rgba(37, 99, 235, 0.04) 15deg,
      transparent 20deg
    );
    animation: radarScanSweep 12s linear infinite;
    opacity: 0.7;
  }

  @keyframes radarScanSweep {
    0% {
      transform: translate(-50%, 50%) rotate(0deg);
    }
    100% {
      transform: translate(-50%, 50%) rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar-scan-sweep {
      animation: none;
      opacity: 0;
    }
  }

  /* ---------------------------------------------------------
     Upper Sky Calm Field Prompt (Matching Picture 1)
     --------------------------------------------------------- */
  .radar-field-prompt {
    position: absolute;
    top: 18%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    max-width: 600px;
    padding: 0 var(--spacing-md);
    z-index: 10;
    pointer-events: none;
  }

  .radar-sky-hint {
    font-size: 0.875rem;
    color: var(--color-muted);
    letter-spacing: -0.2px;
    line-height: 1.4;
    text-align: center;
    opacity: 0.85;
  }

  /* ---------------------------------------------------------
     Bottom-Center Transmitter Beacon (Visual Reference Picture 1)
     --------------------------------------------------------- */
  .radar-transmitter {
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-bottom: 40px;
  }

  .radar-beacon-icon {
    position: relative;
    color: var(--radar-beacon-color);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    margin-bottom: 10px;
  }

  .beacon-svg {
    filter: drop-shadow(0 0 14px rgba(56, 189, 248, 0.5));
  }

  .beacon-halo {
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: radial-gradient(circle, var(--radar-beacon-color) 0%, transparent 75%);
    opacity: 0.25;
    pointer-events: none;
  }

  .radar-transmitter-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
  }

  .radar-self-identity {
    font-size: 0.95rem;
    color: var(--color-ink);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .self-prefix {
    color: var(--color-muted);
  }

  .radar-self-name-btn {
    background: transparent;
    border: none;
    color: var(--color-ink);
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 6px;
    border-radius: var(--radius-xs);
    transition: all 0.15s ease;
  }

  .radar-self-name-btn:hover,
  .radar-self-name-btn:focus-visible {
    background: var(--color-surface-soft);
    color: var(--color-primary);
    outline: none;
  }

  .edit-pencil-icon {
    font-size: 0.85rem;
    color: #38bdf8;
  }

  .radar-self-subtitle {
    font-size: 0.8rem;
    font-weight: 500;
    color: #38bdf8;
    margin-top: 2px;
  }

  /* ---------------------------------------------------------
     Discovered Floating Device Nodes (Visual Reference Picture 1)
     --------------------------------------------------------- */
  .radar-nodes-layer {
    position: absolute;
    inset: 0;
    z-index: 30;
    pointer-events: none;
  }

  .radar-device-node {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: auto !important;
    background: transparent !important;
    border: none !important;
    -webkit-appearance: none !important;
    appearance: none !important;
    box-shadow: none !important;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border-radius: var(--radius-lg);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    outline: none;
    max-width: 140px;
    text-align: center;
    z-index: 35;
  }

  /* Vibrant electric blue circular bubble matching Picture 1 */
  .radar-node-bubble {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #2563eb !important;
    color: #ffffff !important;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(37, 99, 235, 0.4);
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s ease;
  }

  .radar-node-icon {
    font-size: 1.85rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.25));
  }

  /* Pure text group directly below bubble - NO ugly box or pill! */
  .radar-node-text-group {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1px;
    margin-top: 2px;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .radar-node-label {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 140px;
    line-height: 1.25;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
  }

  .radar-node-type {
    font-size: 0.775rem;
    color: var(--color-muted);
    line-height: 1.2;
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
  }

  .radar-device-node:hover .radar-node-bubble,
  .radar-device-node:focus-visible .radar-node-bubble {
    transform: scale(1.1);
    box-shadow: 0 12px 32px rgba(37, 99, 235, 0.55);
  }

  .radar-device-node.selected .radar-node-bubble {
    transform: scale(1.15);
    box-shadow: 0 0 0 4px var(--color-canvas), 0 0 0 8px #2563eb, 0 12px 32px rgba(37, 99, 235, 0.55);
  }

  .radar-device-node.selected .radar-node-label {
    color: #38bdf8;
  }

  /* ---------------------------------------------------------
     Accessible List Fallback View
     --------------------------------------------------------- */
  .discovery-list-container {
    width: 100%;
    max-width: 680px;
    margin: 28px auto;
    padding: 0 var(--spacing-lg) var(--spacing-xxl);
    z-index: 10;
  }

  .discovery-list-header {
    margin-bottom: var(--spacing-lg);
  }

  .discovery-list-titles h3 {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--color-ink);
    margin-bottom: 4px;
  }

  .discovery-list-titles p {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  .discovered-items-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-sm);
  }

  .discovered-list-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--spacing-md) var(--spacing-lg);
  }

  .discovered-item-info {
    display: flex;
    align-items: center;
    gap: var(--spacing-md);
  }

  .discovered-item-icon {
    font-size: 1.8rem;
  }

  .discovered-item-sub {
    display: block;
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .empty-list-state {
    text-align: center;
    padding: var(--spacing-xl);
    font-size: 0.95rem;
    color: var(--color-muted);
  }

  /* ---------------------------------------------------------
     SELECTED DEVICE SHARING OVERLAY
     --------------------------------------------------------- */
  .selected-sharing-overlay {
    position: fixed;
    inset: 0;
    top: 60px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--spacing-md);
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    animation: fadeInOverlay 0.2s ease-out;
  }

  @keyframes fadeInOverlay {
    from { opacity: 0; transform: scale(0.98); }
    to { opacity: 1; transform: scale(1); }
  }

  .selected-sharing-card {
    width: 100%;
    max-width: 500px;
    max-height: calc(100vh - 90px);
    overflow-y: auto;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-xl);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    padding: var(--spacing-lg);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .sharing-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .back-to-radar-btn {
    font-size: 0.825rem;
    font-weight: 600;
  }

  .connection-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-muted);
    background: var(--color-surface-soft);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-hairline);
  }

  .selected-target-banner {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: var(--spacing-md);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-lg);
  }

  .selected-target-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: #2563eb;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 4px 12px rgba(37, 99, 235, 0.35);
  }

  .selected-target-text {
    display: flex;
    flex-direction: column;
  }

  .selected-target-prefix {
    font-size: 0.725rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--color-muted);
    font-weight: 600;
  }

  .selected-target-name {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--color-ink);
    margin: 1px 0;
  }

  .selected-target-sub {
    font-size: 0.8rem;
    color: var(--color-muted);
  }

  .sharing-mode-selector {
    display: flex;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-hairline);
    border-radius: var(--radius-md);
    padding: 3px;
    gap: 4px;
  }

  .mode-tab {
    flex: 1;
    background: transparent;
    border: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-muted);
    padding: 8px 14px;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .mode-tab.active {
    background: var(--color-canvas);
    color: var(--color-ink);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
  }

  /* File Drop Area */
  .drop-zone {
    border: 2px dashed var(--color-hairline);
    border-radius: var(--radius-lg);
    padding: var(--spacing-xl) var(--spacing-lg);
    text-align: center;
    cursor: pointer;
    background: var(--color-surface-soft);
    transition: all 0.2s ease;
    margin-bottom: var(--spacing-md);
  }

  .drop-zone:hover:not(.disabled),
  .drop-zone:focus-visible:not(.disabled),
  .drop-zone.drag-active {
    border-color: #2563eb;
    background: var(--color-surface-card);
    outline: none;
  }

  .drop-zone.disabled {
    opacity: 0.65;
    cursor: pointer;
  }

  .drop-icon {
    font-size: 2.2rem;
    margin-bottom: 6px;
  }

  .drop-zone h4 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 2px;
  }

  .drop-zone p {
    font-size: 0.85rem;
    color: var(--color-muted);
    margin-bottom: 6px;
  }

  .drop-zone-hint {
    font-size: 0.75rem;
    color: var(--color-muted-soft);
  }

  /* Transfers List & Minimal Received File Cards */
  .transfers-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 4px;
  }

  .transfers-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: 280px;
    overflow-y: auto;
    padding-right: 2px;
  }

  .transfer-item {
    padding: 12px 14px;
    border-radius: var(--radius-md);
    background: var(--color-surface-card);
    border: 1px solid var(--color-hairline);
    display: flex;
    flex-direction: column;
    gap: 8px;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .transfer-item:hover {
    border-color: var(--color-hairline-strong, rgba(0, 0, 0, 0.15));
  }

  /* Completed received file card, completed sent card, and failed card */
  .transfer-received-completed,
  .transfer-sent-completed,
  .transfer-failed {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 16px;
  }

  .received-card-main {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
    flex: 1;
  }

  .received-icon-wrapper {
    width: 38px;
    height: 38px;
    border-radius: var(--radius-sm);
    background: rgba(37, 99, 235, 0.08);
    color: #2563eb;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .received-icon-wrapper.error {
    background: rgba(239, 68, 68, 0.1);
    color: var(--color-error);
    font-size: 1.1rem;
  }

  .received-details {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    flex: 1;
  }

  .received-file-name {
    font-size: 0.925rem;
    font-weight: 600;
    color: var(--color-ink);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.25;
  }

  .received-file-sub {
    font-size: 0.775rem;
    color: var(--color-muted);
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .received-file-sub.text-error {
    color: var(--color-error);
  }

  .received-actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  /* Primary Download Button */
  .btn-download {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background-color: #2563eb;
    color: #ffffff !important;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: var(--radius-pill);
    text-decoration: none !important;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: all 0.18s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 2px 8px rgba(37, 99, 235, 0.28);
    flex-shrink: 0;
    outline: none;
  }

  .btn-download:hover {
    background-color: #1d4ed8;
    box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
    transform: translateY(-1px);
  }

  .btn-download:focus-visible {
    outline: 2px solid #2563eb;
    outline-offset: 2px;
  }

  .btn-download:active {
    transform: translateY(0);
    box-shadow: 0 1px 4px rgba(37, 99, 235, 0.2);
  }

  .btn-download svg {
    flex-shrink: 0;
  }

  /* In-progress transfer styling */
  .transfer-in-progress {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .transfer-card-header {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .transfer-details {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .transfer-status-text {
    font-size: 0.75rem;
    color: var(--color-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .btn-cancel-transfer {
    background: transparent;
    border: none;
    color: var(--color-muted);
    font-size: 0.9rem;
    cursor: pointer;
    padding: 6px;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s ease;
    line-height: 1;
    flex-shrink: 0;
  }

  .btn-cancel-transfer:hover {
    color: var(--color-error);
    background: rgba(239, 68, 68, 0.1);
  }

  .progress-bar {
    width: 100%;
    height: 5px;
    background-color: var(--color-hairline);
    border-radius: var(--radius-pill);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background-color: #2563eb;
    border-radius: var(--radius-pill);
    transition: width 0.15s ease;
  }

  /* Text Composer */
  .text-composer-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .text-composer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .composer-label {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .composer-textarea {
    resize: vertical;
    min-height: 85px;
  }

  .text-composer-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .messages-container {
    margin-top: var(--spacing-sm);
  }

  .messages-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-height: 200px;
    overflow-y: auto;
  }

  .message-item {
    padding: 10px 14px;
    font-size: 0.875rem;
    border-radius: var(--radius-md, 8px);
    transition: background-color 0.15s ease;
  }

  .message-item.message-sent {
    background: var(--color-surface, rgba(0, 0, 0, 0.03));
    border-left: 3px solid var(--color-accent, #3b82f6);
  }

  .message-item.message-received {
    background: var(--color-surface, rgba(0, 0, 0, 0.03));
    border-left: 3px solid #10b981;
  }

  .message-body {
    white-space: pre-wrap;
    word-break: break-word;
    overflow-wrap: break-word;
    font-family: inherit;
    line-height: 1.5;
    color: var(--color-fg);
  }

  .message-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--color-muted);
    margin-bottom: 4px;
  }

  .message-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 4px;
  }

  /* ---------------------------------------------------------
     Connected Peer Banner (Floating)
     --------------------------------------------------------- */
  .peer-banner {
    position: absolute;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: 640px;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 20px;
    background: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    border-radius: var(--radius-lg);
  }

  .peer-info-content {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .peer-icon {
    font-size: 1.6rem;
  }

  .peer-title {
    font-size: 0.95rem;
    color: var(--color-ink);
  }

  .peer-subtitle {
    font-size: 0.775rem;
    color: var(--color-muted);
  }

  .peer-status-tag {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* ---------------------------------------------------------
     Modal Dialogs
     --------------------------------------------------------- */
  .modal-dialog {
    border: none;
    background: transparent;
    padding: 0;
    max-width: 440px;
    width: 90%;
    margin: auto;
    z-index: 100;
  }

  .modal-dialog::backdrop {
    background-color: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(3px);
  }

  .modal-content {
    background-color: var(--color-canvas);
    border: 1px solid var(--color-hairline);
    padding: var(--spacing-xl);
    border-radius: var(--radius-xl);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
  }

  .modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--spacing-md);
  }

  .btn-icon-close {
    background: transparent;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    transition: background-color 0.15s ease, color 0.15s ease;
    outline: none;
  }

  .btn-icon-close:hover {
    background: var(--color-surface);
    color: var(--color-ink);
  }

  /* Room / Session Dialog Styling */
  .session-entry-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    margin-bottom: var(--spacing-md);
    line-height: 1.4;
  }

  .room-primary-btn {
    width: 100%;
    height: 42px;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .room-entry-divider {
    display: flex;
    align-items: center;
    margin: var(--spacing-md) 0;
    text-align: center;
    color: var(--color-muted-soft);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .room-entry-divider::before,
  .room-entry-divider::after {
    content: '';
    flex: 1;
    border-bottom: 1px solid var(--color-hairline);
  }

  .room-entry-divider span {
    padding: 0 var(--spacing-sm);
