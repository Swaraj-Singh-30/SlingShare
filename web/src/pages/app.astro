---
import Layout from '../layouts/Layout.astro';
import { getSoftwareApplicationSchema } from '../config/site';

const appStructuredData = getSoftwareApplicationSchema();
---

<Layout
  title="SlingShare App — Fast, Private Peer-to-Peer Transfer"
  description="Connect devices instantly and transfer files and text directly peer-to-peer. No accounts, no cloud storage, completely direct."
  structuredData={appStructuredData}
  noindex={true}
  isApp={true}
>
  <div class="app-viewport">
    <!-- Primary Dominant Experience: The Radar Surface -->
    <section class="radar-surface" id="discoverySection" aria-label="Device Discovery Radar">
      
      <!-- Interactive Radar Canvas -->
      <div class="radar-canvas" id="radarViewport">
        
        <!-- Concentric Radar Arcs anchored at bottom center (50%, 100%) -->
        <div class="radar-arcs-layer" aria-hidden="true">
          <div class="radar-arc radar-arc-1"></div>
          <div class="radar-arc radar-arc-2"></div>
          <div class="radar-arc radar-arc-3"></div>
          <div class="radar-arc radar-arc-4"></div>
          <div class="radar-arc radar-arc-5"></div>
          <div class="radar-arc radar-arc-6"></div>
          <div class="radar-arc radar-arc-7"></div>
          <div class="radar-arc radar-arc-8"></div>
          <div class="radar-scan-sweep"></div>
        </div>

        <!-- Upper Sky Calm Prompt (Strictly matching visual reference Picture 1) -->
        <div class="radar-field-prompt" id="radarFieldPrompt">
          <p class="radar-sky-hint" id="discoveryStatusText">Click to send files or right click to send a message and paste an image</p>
        </div>

        <!-- Discovered Device Nodes Layer (Plotted in the Arc Expanse) -->
        <div class="radar-nodes-layer" id="radarNodesLayer"></div>

        <!-- Bottom-Center Transmitter Beacon (Visual Reference Alignment) -->
        <div class="radar-transmitter" id="radarSelfNode">
          <div class="radar-beacon-icon" aria-hidden="true">
            <svg class="beacon-svg" width="56" height="56" viewBox="0 0 64 64" fill="none">
              <!-- Radiating broadcast arches -->
              <path d="M12 28 C12 16, 52 16, 52 28" stroke="var(--radar-beacon-color)" stroke-width="2.8" stroke-linecap="round" fill="none" opacity="0.45" />
              <path d="M18 34 C18 24, 46 24, 46 34" stroke="var(--radar-beacon-color)" stroke-width="2.8" stroke-linecap="round" fill="none" opacity="0.75" />
              <path d="M24 40 C24 33, 40 33, 40 40" stroke="var(--radar-beacon-color)" stroke-width="3" stroke-linecap="round" fill="none" />
              <!-- Transmitter apex triangle -->
              <polygon points="32,38 24,52 40,52" fill="var(--radar-beacon-color)" />
              <circle cx="32" cy="38" r="2.5" fill="#ffffff" />
            </svg>
            <div class="beacon-halo"></div>
            <span class="beacon-core-dot" id="radarSelfIcon" style="display: none;"></span>
          </div>
          <div class="radar-transmitter-info">
            <div class="radar-self-identity">
              <span class="self-prefix">You are known as </span>
              <button id="editDeviceNameBtn" class="radar-self-name-btn" title="Click to rename device" aria-label="Edit device name">
                <strong id="localDeviceName">Detecting...</strong>
                <span class="edit-pencil-icon" aria-hidden="true">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
                  </svg>
                </span>
              </button>
            </div>
            <p class="radar-self-subtitle">You can be discovered by everyone on this network</p>
          </div>
        </div>
      </div>

      <!-- Accessible List View Fallback (When List view toggled) -->
      <div class="discovery-list-container" id="discoveryListContainer" style="display: none;">
        <div class="discovery-list-header">
          <div class="discovery-list-titles">
            <h3>Nearby Discovered Devices</h3>
            <p>Select any available peer to connect and share files:</p>
          </div>
        </div>
        <div class="discovered-items-list" id="discoveredItemsList">
          <div class="empty-list-state" id="emptyListState">
            No other SlingShare devices found. Open SlingShare on another device to discover it here.
          </div>
        </div>
      </div>
    </section>

    <!-- SELECTED DEVICE SHARING OVERLAY (Revealed ONLY after device selection) -->
    <div class="selected-sharing-overlay" id="selectedSharingOverlay" style="display: none;">
      <div class="selected-sharing-card card" id="selectedSharingCard" role="region" aria-label="Device Sharing Controls">
        
        <!-- Header row with Back button & Connection Status -->
        <div class="sharing-card-header">
          <div style="display: flex; gap: 8px; align-items: center;">
            <button id="backToRadarBtn" class="btn btn-secondary btn-sm back-to-radar-btn" title="Choose another device">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"></line>
                <polyline points="12 19 5 12 12 5"></polyline>
              </svg>
              <span>Choose another device</span>
            </button>
            <button id="retryConnectionBtn" class="btn btn-secondary btn-sm" title="Retry connection" style="display: none;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="23 4 23 10 17 10"></polyline>
                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"></path>
              </svg>
              <span>Retry</span>
            </button>
          </div>
          <div class="connection-pill" id="connectionPill">
            <span class="status-indicator disconnected" id="statusDot"></span>
            <span id="connectionStatusText">Connecting...</span>
            <span class="badge badge-card" id="connectionTypeBadge" style="display: none;">Direct P2P</span>
          </div>
        </div>

        <!-- Target Device Info Banner -->
        <div class="selected-target-banner">
          <div class="selected-target-avatar" id="selectedTargetIcon"></div>
          <div class="selected-target-text">
            <span class="selected-target-prefix">Sending to</span>
            <h3 class="selected-target-name" id="remotePeerName">Target Device</h3>
            <span class="selected-target-sub" id="remotePeerSubtitle">Waiting for connection...</span>
          </div>
        </div>

        <!-- Sharing Mode Selector: [ File ] [ Text ] -->
        <div class="sharing-mode-selector" role="tablist">
          <button class="mode-tab active" id="tabFilesBtn" role="tab" aria-selected="true" aria-controls="panelFiles">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
              <polyline points="13 2 13 9 20 9"></polyline>
            </svg>
            <span>Files</span>
          </button>
          <button class="mode-tab" id="tabTextBtn" role="tab" aria-selected="false" aria-controls="panelText">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
            </svg>
            <span>Text</span>
          </button>
        </div>

        <!-- Mode Panel: File Transfer -->
        <div class="mode-content-panel active" id="panelFiles" role="tabpanel" aria-labelledby="tabFilesBtn">
          <div class="drop-zone disabled" id="dropZone" tabindex="0" role="button" aria-label="Drop files here or click to select files">
            <input type="file" id="fileInput" multiple style="display: none;" />
            <div class="drop-zone-content">
              <div class="drop-icon" id="dropZoneIcon">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                  <polyline points="17 8 12 3 7 8"></polyline>
                  <line x1="12" y1="3" x2="12" y2="15"></line>
                </svg>
              </div>
              <h4 id="dropZoneTitle">Connecting...</h4>
              <p id="dropZoneSubtitle">File transfer will enable automatically once connected</p>
              <span class="drop-zone-hint" id="dropZoneHint">Direct WebRTC DataChannel streaming</span>
            </div>
          </div>

          <!-- Active Transfers Progress List -->
          <div class="transfers-container" id="transfersSection">
            <div class="transfers-list" id="transfersList">
              <div class="empty-state" id="emptyTransfersState" style="display: none;">
                No active transfers. Drop a file to begin.
              </div>
            </div>
          </div>
        </div>

        <!-- Mode Panel: Text & Clipboard -->
        <div class="mode-content-panel" id="panelText" role="tabpanel" aria-labelledby="tabTextBtn" style="display: none;">
          <div class="text-composer-card">
            <div class="text-composer-top">
              <label for="textShareInput" class="composer-label">Send text</label>
              <button id="pasteClipboardBtn" class="btn btn-secondary btn-sm" title="Paste from clipboard">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
                  <rect x="8" y="2" width="8" height="4" rx="1" ry="1"></rect>
                </svg>
                <span>Paste</span>
              </button>
            </div>
            <textarea
              id="textShareInput"
              class="textarea composer-textarea"
              rows="4"
              placeholder="Type or paste text, links, or notes..."
            ></textarea>
            <div class="text-composer-footer">
              <span class="char-count" id="textCharCount">0 characters</span>
              <button id="sendTextBtn" class="btn btn-primary" disabled>
                Send Text
              </button>
            </div>
          </div>

          <!-- Sent / Received Snippets -->
          <div class="messages-container" id="messagesSection">
            <div class="section-header-row" id="messagesHeaderRow" style="display: none;">
              <h4>Conversation History</h4>
              <button id="clearMessagesBtn" class="btn-text-action">Clear</button>
            </div>
            <div class="messages-list" id="messagesList">
              <div class="empty-state" id="emptyMessagesState" style="display: none;">
                No messages yet.
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Connected Peer Floating Banner (Preserved for status indicators) -->
    <div id="peerBanner" class="peer-banner card" style="display: none;">
      <div class="peer-info-content">
        <div class="peer-icon" id="remotePeerIcon"></div>
        <div class="peer-text">
          <div class="peer-title">Connected with <strong id="bannerRemotePeerName">Remote Device</strong></div>
          <div class="peer-subtitle" id="bannerRemotePeerSubtitle">Direct WebRTC DataChannel active • End-to-end encrypted</div>
        </div>
      </div>
      <div class="peer-status-tag">
        <span class="badge badge-success">
          <span class="badge-dot"></span> Paired
        </span>
        <button id="leaveSessionBtn" class="btn btn-secondary btn-sm btn-danger-hover">Leave</button>
      </div>
    </div>

    <!-- Hidden state elements for testing & status preservation -->
    <div class="system-status-hidden" style="display: none;">
      <span class="badge badge-card" id="transfersCount">0 active</span>
      <span id="localDeviceIcon"></span>
    </div>

    <!-- Manual Room & QR Pairing Dialog (Accessible via header pair button) -->
    <dialog id="sessionModal" class="modal-dialog">
      <div class="modal-content card">
        <div class="modal-header">
          <h3>Pair via Room Code or QR</h3>
          <button id="closeSessionModalBtn" class="btn-icon-close" aria-label="Close dialog">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="modal-body">
          <div class="session-entry-group" id="sessionEntryGroup">
            <p class="session-entry-desc">
              Create a private temporary room or enter an existing code:
            </p>
            <button id="createSessionBtn" class="btn btn-primary room-primary-btn">Create New Room</button>
            <div class="room-entry-divider">
              <span>or enter code</span>
            </div>
            <div class="join-inline-group">
              <input
                type="text"
                id="joinCodeInput"
                class="input join-input"
                placeholder="6-character code"
                maxlength="6"
                aria-label="Enter 6-character room code"
              />
              <button id="joinSessionBtn" class="btn btn-secondary room-join-btn">Join</button>
            </div>
          </div>

          <div class="session-active-group" id="sessionActiveGroup" style="display: none;">
            <div class="active-room-card">
              <div class="active-room-info">
                <span class="active-room-label">Active Room Code</span>
                <code class="active-room-code" id="activeSessionCode">------</code>
              </div>
              <div class="active-room-actions">
                <button id="copyCodeBtn" class="btn btn-secondary btn-sm" title="Copy Room Code">Copy</button>
                <button id="showQrBtn" class="btn btn-secondary btn-sm" title="Show QR Code">QR</button>
                <button id="modalLeaveSessionBtn" class="btn btn-secondary btn-sm btn-danger-hover">Leave</button>
              </div>
            </div>
          </div>

          <!-- Waiting Prompt (For manually joined rooms) -->
          <div class="waiting-prompt card" id="waitingPrompt" style="display: none; margin-top: 16px;">
            <div class="waiting-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <circle cx="12" cy="12" r="6"></circle>
                <circle cx="12" cy="12" r="2"></circle>
              </svg>
            </div>
            <h4>Waiting for peer to join</h4>
            <p class="waiting-desc">
              Enter room code <strong id="waitingPromptCode">------</strong> on your second device or scan the QR code.
            </p>
            <button id="waitingPromptQrBtn" class="btn btn-secondary btn-sm">View Pairing QR Code</button>
          </div>
        </div>
      </div>
    </dialog>

    <!-- QR Code Modal Dialog -->
    <dialog id="qrModal" class="modal-dialog">
      <div class="modal-content card">
        <div class="modal-header">
          <h3>Pair Device</h3>
          <button id="closeQrModalBtn" class="btn-icon-close" aria-label="Close dialog">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="modal-body">
          <p class="modal-desc">Scan with your phone or tablet camera to join this session directly:</p>
          <div class="qr-wrapper">
            <canvas id="qrCanvas"></canvas>
          </div>
          <div class="share-link-group">
            <input type="text" id="shareUrlInput" class="input input-sm" readonly />
            <button id="copyShareUrlBtn" class="btn btn-primary btn-sm">Copy Link</button>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Edit Device Name Modal Dialog -->
    <dialog id="editNameModal" class="modal-dialog">
      <div class="modal-content card">
        <div class="modal-header">
          <h3>Edit Device Name</h3>
          <button id="closeEditNameModalBtn" class="btn-icon-close" aria-label="Close dialog">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="modal-body">
          <div style="margin-bottom: 16px;">
            <label for="customDeviceNameInput" style="display: block; font-size: 0.9rem; margin-bottom: 8px;">Device Name (1–40 characters):</label>
            <input type="text" id="customDeviceNameInput" class="input" maxlength="40" placeholder="e.g. Swaraj's MacBook, Work Laptop" />
            <small id="deviceNameError" style="color: var(--color-error); display: none; margin-top: 4px;">Name must be between 1 and 40 characters.</small>
          </div>
          <div style="display: flex; justify-content: flex-end; gap: 8px;">
            <button id="cancelEditNameBtn" class="btn btn-secondary btn-sm">Cancel</button>
            <button id="saveEditNameBtn" class="btn btn-primary btn-sm">Save</button>
          </div>
        </div>
      </div>
    </dialog>

    <!-- Info / Network Modal Dialog -->
    <dialog id="infoModal" class="modal-dialog">
      <div class="modal-content card">
        <div class="modal-header">
          <h3>About SlingShare</h3>
          <button id="closeInfoModalBtn" class="btn-icon-close" aria-label="Close dialog">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>
        </div>
        <div class="modal-body">
          <p style="margin-bottom: 12px; font-size: 0.95rem;">
            <strong>SlingShare</strong> is a privacy-first, zero-cloud peer-to-peer file and text sharing application.
          </p>
          <ul style="padding-left: 20px; font-size: 0.9rem; line-height: 1.6; color: var(--color-body); margin-bottom: 16px;">
            <li>Direct WebRTC DataChannels between your devices.</li>
            <li>No accounts, no tracking, zero server storage.</li>
            <li>Chunked streaming with SHA-256 cryptographic verification.</li>
            <li>Active device discovery without local network IP scanning.</li>
          </ul>
          <p style="font-size: 0.85rem; color: var(--color-muted);">
            Nearby devices running SlingShare discover each other automatically.
          </p>
        </div>
      </div>
    </dialog>

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="toast-container" aria-live="polite"></div>
  </div>

  <!-- Client-side Application Logic -->
  <script>
    import QRCode from 'qrcode';
    import { detectDevice, saveCustomDeviceName, validateDeviceNameResult } from '../lib/device';
    import { SignalingClient } from '../lib/signaling';
    import { WebRTCManager } from '../lib/webrtc';
    import { TransferManager } from '../lib/transfer';
    import type { FileTransferState, DataChannelMessage, DiscoveredDevice } from '../lib/types';
    import { trackEvent } from '../lib/analytics';

    // Application State
    let localDevice = detectDevice();
    let currentSessionId = '';
    let myPeerId = '';
    let selectedDevice: DiscoveredDevice | null = null;
    let connectedPeer: { id: string; deviceName: string; deviceType: string } | null = null;
    let isInitiator = false;
    let pendingFilesToSend: File[] = [];

    // Discovery State
    const discoveredDevices = new Map<string, DiscoveredDevice>();
    let currentViewMode: 'radar' | 'list' = 'radar';

    // Core Managers
    let signaling: SignalingClient;
    let webrtc: WebRTCManager;
    let transferMgr: TransferManager;

    // DOM Elements
    const localDeviceNameEl = document.getElementById('localDeviceName')!;
    const editDeviceNameBtn = document.getElementById('editDeviceNameBtn')!;
    const statusDotEl = document.getElementById('statusDot')!;
    const connectionStatusTextEl = document.getElementById('connectionStatusText')!;
    const connectionTypeBadgeEl = document.getElementById('connectionTypeBadge')!;

    // Header actions
    const appMenuBtn = document.getElementById('appMenuBtn');
    const appMenuDropdown = document.getElementById('appMenuDropdown');
    const headerPairBtn = document.getElementById('headerPairBtn');
    const headerWorkspaceToggleBtn = document.getElementById('headerWorkspaceToggleBtn');
    const headerTransfersBadge = document.getElementById('headerTransfersBadge');
    const headerInfoBtn = document.getElementById('headerInfoBtn');

    // Modals
    const sessionModal = document.getElementById('sessionModal') as HTMLDialogElement;
    const closeSessionModalBtn = document.getElementById('closeSessionModalBtn');
    const infoModal = document.getElementById('infoModal') as HTMLDialogElement;
    const closeInfoModalBtn = document.getElementById('closeInfoModalBtn');

    // Session controls
    const sessionEntryGroup = document.getElementById('sessionEntryGroup')!;
    const sessionActiveGroup = document.getElementById('sessionActiveGroup')!;
    const createSessionBtn = document.getElementById('createSessionBtn') as HTMLButtonElement;
    const joinCodeInput = document.getElementById('joinCodeInput') as HTMLInputElement;
    const joinSessionBtn = document.getElementById('joinSessionBtn') as HTMLButtonElement;
    const activeSessionCodeEl = document.getElementById('activeSessionCode')!;
    const copyCodeBtn = document.getElementById('copyCodeBtn')!;
    const showQrBtn = document.getElementById('showQrBtn')!;
    const leaveSessionBtn = document.getElementById('leaveSessionBtn')!;
    const modalLeaveSessionBtn = document.getElementById('modalLeaveSessionBtn');

    // Peer banner & Waiting prompt
    const peerBanner = document.getElementById('peerBanner')!;
    const remotePeerNameEl = document.getElementById('remotePeerName')!;
    const remotePeerSubtitleEl = document.getElementById('remotePeerSubtitle')!;
    const bannerRemotePeerName = document.getElementById('bannerRemotePeerName');
    const bannerRemotePeerSubtitle = document.getElementById('bannerRemotePeerSubtitle');
    const remotePeerIconEl = document.getElementById('remotePeerIcon')!;
    const waitingPrompt = document.getElementById('waitingPrompt')!;
    const waitingPromptCodeEl = document.getElementById('waitingPromptCode')!;
    const waitingPromptQrBtn = document.getElementById('waitingPromptQrBtn')!;

    // Discovery & Radar Elements
    const discoverySection = document.getElementById('discoverySection')!;
    const discoveryStatusText = document.getElementById('discoveryStatusText')!;
    const radarViewport = document.getElementById('radarViewport')!;
    const radarNodesLayer = document.getElementById('radarNodesLayer')!;
    const discoveryListContainer = document.getElementById('discoveryListContainer')!;
    const discoveredItemsList = document.getElementById('discoveredItemsList')!;
    const headerViewRadarBtn = document.getElementById('headerViewRadarBtn');
    const headerViewListBtn = document.getElementById('headerViewListBtn');

    // Selected Device Sharing Card Elements
    const selectedSharingOverlay = document.getElementById('selectedSharingOverlay')!;
    const selectedSharingCard = document.getElementById('selectedSharingCard')!;
    const backToRadarBtn = document.getElementById('backToRadarBtn')!;
    const selectedTargetIconEl = document.getElementById('selectedTargetIcon')!;
    const retryConnectionBtn = document.getElementById('retryConnectionBtn');
    const tabFilesBtn = document.getElementById('tabFilesBtn')!;
    const tabTextBtn = document.getElementById('tabTextBtn')!;
    const panelFiles = document.getElementById('panelFiles')!;
    const panelText = document.getElementById('panelText')!;

    const dropZone = document.getElementById('dropZone')!;
    const dropZoneIconEl = document.getElementById('dropZoneIcon');
    const dropZoneTitleEl = document.getElementById('dropZoneTitle');
    const dropZoneSubtitleEl = document.getElementById('dropZoneSubtitle');
    const dropZoneHintEl = document.getElementById('dropZoneHint');
    const fileInput = document.getElementById('fileInput') as HTMLInputElement;
    const transfersList = document.getElementById('transfersList')!;
    const emptyTransfersState = document.getElementById('emptyTransfersState')!;
    const transfersCountEl = document.getElementById('transfersCount')!;

    const textShareInput = document.getElementById('textShareInput') as HTMLTextAreaElement;
    const textCharCountEl = document.getElementById('textCharCount')!;
    const sendTextBtn = document.getElementById('sendTextBtn') as HTMLButtonElement;
    const pasteClipboardBtn = document.getElementById('pasteClipboardBtn')!;
    const messagesSection = document.getElementById('messagesSection')!;
    const messagesHeaderRow = document.getElementById('messagesHeaderRow')!;
    const messagesList = document.getElementById('messagesList')!;
    const emptyMessagesState = document.getElementById('emptyMessagesState')!;
    const clearMessagesBtn = document.getElementById('clearMessagesBtn')!;

    const qrModal = document.getElementById('qrModal') as HTMLDialogElement;
    const qrCanvas = document.getElementById('qrCanvas') as HTMLCanvasElement;
    const shareUrlInput = document.getElementById('shareUrlInput') as HTMLInputElement;
    const copyShareUrlBtn = document.getElementById('copyShareUrlBtn')!;
    const closeQrModalBtn = document.getElementById('closeQrModalBtn')!;

    const editNameModal = document.getElementById('editNameModal') as HTMLDialogElement;
    const customDeviceNameInput = document.getElementById('customDeviceNameInput') as HTMLInputElement;
    const deviceNameError = document.getElementById('deviceNameError')!;
    const cancelEditNameBtn = document.getElementById('cancelEditNameBtn')!;
    const saveEditNameBtn = document.getElementById('saveEditNameBtn')!;
    const closeEditNameModalBtn = document.getElementById('closeEditNameModalBtn')!;

    const toastContainer = document.getElementById('toastContainer')!;

    // UI Helpers
    function showToast(message: string, duration = 3000) {
      const toast = document.createElement('div');
      toast.className = 'toast';
      toast.textContent = message;
      toastContainer.appendChild(toast);
      setTimeout(() => {
        toast.classList.add('fade-out');
        setTimeout(() => toast.remove(), 300);
      }, duration);
    }

    function getDeviceIcon(type: string): string {
      return getDeviceIconSvg(type);
    }

    function getDeviceIconSvg(type: string): string {
      switch (type) {
        case 'phone':
          return `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="device-vector-svg">
            <rect x="6" y="2" width="12" height="20" rx="3" fill="#ffffff"/>
            <rect x="8" y="4.5" width="8" height="13" rx="1" fill="#2563eb"/>
            <circle cx="12" cy="19.5" r="0.8" fill="#2563eb"/>
          </svg>`;
        case 'tablet':
          return `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="device-vector-svg">
            <rect x="4" y="2" width="16" height="20" rx="2.5" fill="#ffffff"/>
            <rect x="6" y="4" width="12" height="15" rx="1" fill="#2563eb"/>
            <circle cx="12" cy="20" r="0.8" fill="#2563eb"/>
          </svg>`;
        case 'laptop':
          return `<svg width="34" height="34" viewBox="0 0 24 24" fill="none" class="device-vector-svg">
            <rect x="4" y="4" width="16" height="11" rx="1.5" fill="#ffffff"/>
            <rect x="5.5" y="5.5" width="13" height="8" rx="0.5" fill="#2563eb"/>
            <path d="M2 18h20a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1z" fill="#ffffff"/>
          </svg>`;
        case 'desktop':
        default:
          return `<svg width="34" height="34" viewBox="0 0 24 24" fill="none" class="device-vector-svg">
            <rect x="3" y="3" width="18" height="13" rx="2" fill="#ffffff"/>
            <rect x="4.5" y="4.5" width="15" height="10" rx="1" fill="#2563eb"/>
            <path d="M12 16v4M8 20h8" stroke="#ffffff" stroke-width="2.2" stroke-linecap="round"/>
          </svg>`;
      }
    }

    function formatDeviceTypeLabel(type: string): string {
      switch (type) {
        case 'phone':
          return 'Phone';
        case 'tablet':
          return 'Tablet';
        case 'laptop':
          return 'Laptop';
        case 'desktop':
        default:
          return 'Computer';
      }
    }

    function formatBytes(bytes: number): string {
      if (bytes === 0) return '0 B';
      const k = 1024;
      const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
      const i = Math.floor(Math.log(bytes) / Math.log(k));
      return `${parseFloat((bytes / Math.pow(k, i)).toFixed(1))} ${sizes[i]}`;
    }

    function formatSpeed(bytesPerSec: number): string {
      return `${formatBytes(bytesPerSec)}/s`;
    }

    function escapeHtml(str: string): string {
      return (str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
    }

    function getFileExtension(fileName: string): string {
      const parts = (fileName || '').split('.');
      if (parts.length > 1) {
        const ext = parts.pop()!.toUpperCase();
        if (ext.length <= 6) return ext;
      }
      return 'FILE';
    }

    function getFileCategoryIconSvg(fileName: string, mimeType: string = ''): string {
      const ext = (fileName || '').split('.').pop()?.toLowerCase() || '';
      const mime = (mimeType || '').toLowerCase();

      // Images
      if (['png', 'jpg', 'jpeg', 'gif', 'webp', 'svg', 'bmp', 'ico', 'heic'].includes(ext) || mime.startsWith('image/')) {
        return `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
          <circle cx="8.5" cy="8.5" r="1.5"/>
          <polyline points="21 15 16 10 5 21"/>
        </svg>`;
      }

      // Documents / PDF
      if (ext === 'pdf' || mime === 'application/pdf') {
        return `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
          <polyline points="14 2 14 8 20 8"/>
          <line x1="16" y1="13" x2="8" y2="13"/>
          <line x1="16" y1="17" x2="8" y2="17"/>
        </svg>`;
      }

      // Audio
      if (['mp3', 'wav', 'flac', 'aac', 'ogg', 'm4a'].includes(ext) || mime.startsWith('audio/')) {
        return `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18V5l12-2v13"/>
          <circle cx="6" cy="18" r="3"/>
          <circle cx="18" cy="16" r="3"/>
        </svg>`;
      }

      // Video
      if (['mp4', 'mov', 'avi', 'mkv', 'webm', 'wmv'].includes(ext) || mime.startsWith('video/')) {
        return `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polygon points="23 7 16 12 23 17 23 7"/>
          <rect x="1" y="5" width="15" height="14" rx="2" ry="2"/>
        </svg>`;
      }

      // Archive / Zip
      if (['zip', 'rar', 'tar', 'gz', '7z', 'bz2', 'xz'].includes(ext) || mime.includes('zip') || mime.includes('tar') || mime.includes('compressed')) {
        return `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="21 8 21 21 3 21 3 8"/>
          <rect x="1" y="3" width="22" height="5"/>
          <line x1="10" y1="12" x2="14" y2="12"/>
        </svg>`;
      }

      // Code / Text
      if (['txt', 'md', 'json', 'csv', 'js', 'ts', 'jsx', 'tsx', 'html', 'css', 'go', 'py', 'java', 'c', 'cpp', 'rs', 'sh'].includes(ext) || mime.startsWith('text/')) {
        return `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>`;
      }

      // Default File
      return `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
        <polyline points="13 2 13 9 20 9"/>
      </svg>`;
    }

