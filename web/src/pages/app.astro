    }

    // Device Name Editing - Validates and Accepts "Swaraj's MacBook", etc.
    editDeviceNameBtn.addEventListener('click', () => {
      customDeviceNameInput.value = localDevice.deviceName;
      deviceNameError.style.display = 'none';
