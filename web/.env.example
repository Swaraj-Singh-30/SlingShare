# SlingShare Frontend Environment Variables
# Copy to .env or .env.local for local development

# WebSocket signaling server endpoint
# Local development fallback: ws://localhost:10000/ws
# Production Render endpoint: wss://slingshare.onrender.com/ws
PUBLIC_WS_URL=ws://localhost:10000/ws

# Google Analytics 4 Measurement ID (Optional, format: G-XXXXXXXXXX)
PUBLIC_GA_ID=
